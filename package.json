{
  "name": "openchamber-plugins",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": ["plugins/*"],
  "scripts": {
    "check": "bun run typecheck && bun run lint",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "test:browser": "bun testing/e2e/mutation-guard.ts && bun testing/e2e/status-section.ts",
    "build": "bun run tooling/build.ts",
    "package": "bun run tooling/package.ts",
    "validate": "bun run tooling/validate.ts",
    "test:app:stock": "bun run tooling/test-app.ts stock",
    "test:app:electron": "bun run tooling/test-app.ts electron"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.0.1",
    "@eslint/js": "^9.33.0",
    "@types/bun": "^1.2.20",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "playwright": "^1.55.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.39.1"
  }
}
