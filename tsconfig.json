{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": [
    "plugins/**/*.ts",
    "plugins/**/*.tsx",
    "tooling/**/*.ts",
    "testing/**/*.ts"
  ]
}
